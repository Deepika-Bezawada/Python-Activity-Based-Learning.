
# Employee Payroll and Deduction Analysis

# Input employee details
name = input("Enter employee name: ")
emp_id = input("Enter employee ID: ")

basic = float(input("Enter basic pay: Rs. "))
allowances = float(input("Enter allowances: Rs. "))
overtime = float(input("Enter overtime amount: Rs. "))
incentive = float(input("Enter incentive: Rs. "))

# Calculate gross salary
gross = basic + allowances + overtime + incentive

# Calculate progressive deductions
if gross <= 20000:
    deduction = gross * 0.05
elif gross <= 40000:
    deduction = (20000 * 0.05) + ((gross - 20000) * 0.10)
else:
    deduction = (20000 * 0.05) + (20000 * 0.10) + ((gross - 40000) * 0.15)

# Calculate net salary
net_salary = gross - deduction

# Display salary statement
print(" SALARY STATEMENT ")
print("Employee Name :", name)
print("Employee ID   :", emp_id)
print(" ")
print("Basic Pay     : Rs.", round(basic, 2))
print("Allowances    : Rs.", round(allowances, 2))
print("Overtime      : Rs.", round(overtime, 2))
print("Incentive     : Rs.", round(incentive, 2))
print("--------------------------------------")
print("Gross Salary  : Rs.", round(gross, 2))
print("Deductions    : Rs.", round(deduction, 2))
print("Net Salary    : Rs.", round(net_salary, 2))
print(" ")

# Payroll analysis
print(" PAYROLL ANALYSIS ")
print("Gross Salary :", round(gross, 2))
print("Deduction %  :", round((deduction / gross) * 100, 2)
      if gross > 0 else 0, "%")
print("Take-home Pay:", round(net_salary, 2))



