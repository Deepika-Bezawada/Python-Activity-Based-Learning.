
# Retail Billing System

total_amount = 0
total_discount = 0
max_concession = 500

n = int(input("Enter number of products: "))

print(" RETAIL INVOICE ")

for i in range(n):
    print("\nProduct", i + 1)

    name = input("Enter product name: ")
    category = input("Enter category (food/clothing/electronics): ")
    price = float(input("Enter price per item: Rs. "))
    quantity = int(input("Enter quantity: "))

    amount = price * quantity

    # Category discount
    if category.lower() == "food":
        discount_rate = 5
    elif category.lower() == "clothing":
        discount_rate = 10
    elif category.lower() == "electronics":
        discount_rate = 8
    else:
        discount_rate = 0

    discount = amount * discount_rate / 100

    # Threshold discount
    if amount >= 5000:
        discount = discount + amount * 0.05

    # Maximum concession limit
    if discount > max_concession:
        discount = max_concession

    final_amount = amount - discount

    total_amount = total_amount + amount
    total_discount = total_discount + discount

    print("\nProduct:", name)
    print("Category:", category)
    print("Quantity:", quantity)
    print("Original Amount: Rs.", round(amount, 2))
    print("Discount: Rs.", round(discount, 2))
    print("Final Amount: Rs.", round(final_amount, 2))

# Final invoice
print(" FINAL INVOICE ")
print("Total Amount: Rs.", round(total_amount, 2))
print("Total Discount: Rs.", round(total_discount, 2))
print("Grand Total: Rs.", round(total_amount - total_discount, 2))
print("")

