
# Progressive Electicity Bill
bills = []

months = ["January", "February", "March", "April"]

for month in months:
    print("\nEnter details for", month)

    units = float(input("Enter electricity units consumed: "))
    fixed = float(input("Enter fixed charges: Rs. "))
    extra = float(input("Enter extra charges: Rs. "))
    rebate = float(input("Enter rebate amount: Rs. "))

    # Calculate bill
    bill = (units * 5) + fixed + extra - rebate

    if bill < 0:
        bill = 0

    bills.append(bill)

    print("Total bill for", month, "= Rs.", round(bill, 2))

# Compare monthly bills
print(" Monthly Bill Comparison ")

for i in range(len(months)):
    print(months[i], ": Rs.", round(bills[i], 2))

# Find highest and lowest bills
highest = max(bills)
lowest = min(bills)

print("Highest bill: Rs.", round(highest, 2))
print("Lowest bill: Rs.", round(lowest, 2))

# Calculate average bill
average = sum(bills) / len(bills)
print("Average monthly bill: Rs.", round(average, 2))

# Identify anomalies
print(" Anomaly Detection ")

for i in range(len(bills)):
    if bills[i] > average * 1.5:
        print(months[i], "has an unusually high bill.")
    elif bills[i] < average * 0.5:
        print(months[i], "has an unusually low bill.")

# Identify patterns
print(" Bill Patterns ")

for i in range(1, len(bills)):
    if bills[i] > bills[i - 1]:
        print(months[i], ": Bill increased.")
    elif bills[i] < bills[i - 1]:
        print(months[i], ": Bill decreased.")


