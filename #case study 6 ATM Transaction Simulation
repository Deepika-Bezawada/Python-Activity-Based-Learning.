
# ATM Transaction Simulation

balance = float(input("Enter initial balance: Rs. "))

total_deposits = 0
total_withdrawals = 0
rejected = 0

max_withdrawal = 10000

n = int(input("Enter number of transactions: "))

for i in range(n):
    print("\nTransaction", i + 1)
    choice = input("Enter deposit or withdraw: ").lower()
    amount = float(input("Enter amount: Rs. "))

    if amount <= 0:
        print("Invalid amount! Transaction rejected.")
        rejected += 1

    elif choice == "deposit":
        balance += amount
        total_deposits += amount
        print("Deposit successful.")

    elif choice == "withdraw":
        if amount > max_withdrawal:
            print("Rejected! Withdrawal limit is Rs. 10000.")
            rejected += 1
        elif amount > balance:
            print("Rejected! Insufficient balance.")
            rejected += 1
        else:
            balance -= amount
            total_withdrawals += amount
            print("Withdrawal successful.")

    else:
        print("Invalid transaction type!")
        rejected += 1

    print("Current balance: Rs.", round(balance, 2))

# Transaction Summary
print("  ATM TRANSACTION SUMMARY ")
print("Total Deposits: Rs.", round(total_deposits, 2))
print("Total Withdrawals: Rs.", round(total_withdrawals, 2))
print("Rejected Transactions:", rejected)
print("Final Balance: Rs.", round(balance, 2))
print("=====================================")
