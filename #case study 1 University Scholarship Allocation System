
# University Scholarship Allocation System

students = []

n = int(input("Enter number of applicants: "))
seats = int(input("Enter number of scholarship seats: "))

# Collect student details
for i in range(n):
    print("\nEnter details for Student", i + 1)

    name = input("Student name: ")
    aggregate = float(input("Aggregate marks (%): "))
    maths = float(input("Mathematics marks (%): "))
    physics = float(input("Physics marks (%): "))
    programming = float(input("Programming marks (%): "))
    attendance = float(input("Attendance (%): "))
    income = float(input("Annual family income (Rs.): "))

    subject_avg = (maths + physics + programming) / 3

    # Check eligibility
    if (aggregate >= 75 and maths >= 60 and
        physics >= 60 and programming >= 60 and
        attendance >= 75 and income <= 300000):

        students.append({
            "name": name,
            "aggregate": aggregate,
            "subject_avg": subject_avg,
            "attendance": attendance,
            "income": income
        })

# Rank students using predefined tie-breaking rules
students.sort(key=lambda s: (
    -s["aggregate"],
    -s["subject_avg"],
    -s["attendance"],
    s["income"]
))

print(" SCHOLARSHIP RESULTS")

if len(students) == 0:
    print("No eligible applicants found.")

else:
    for i, student in enumerate(students):
        print("\nRank:", i + 1)
        print("Name:", student["name"])
        print("Aggregate:", student["aggregate"], "%")
        print("Subject Average:", round(student["subject_avg"], 2), "%")

        if i < seats:
            if i == 0:
                amount = 20000
            elif i == 1:
                amount = 15000
            else:
                amount = 10000

            print("Status: Scholarship Allocated")
            print("Scholarship Amount: Rs.", amount)

        else:
            print("Status: Waitlisted")

print("\nTotal Eligible Applicants:", len(students))
print("Scholarship Seats Available:", seats)
print("Selected Applicants:", min(seats, len(students)))

