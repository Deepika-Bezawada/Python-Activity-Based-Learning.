# Universal Scholarship Allocation

name = input("Enter student name: ")
marks = float(input("Enter marks percentage: "))
income = float(input("Enter annual family income: "))

print("Scholarship Details")
print("Student Name:", name)
print("Marks:", marks, "%")
print("Family Income: Rs.", income)

if marks >= 90 and income <= 200000:
    scholarship = 20000
    print("Scholarship Category: Excellent")
elif marks >= 75 and income <= 300000:
    scholarship = 15000
    print("Scholarship Category: Merit")
elif marks >= 60 and income <= 500000:
    scholarship = 10000
    print("Scholarship Category: General")
else:
    scholarship = 0
    print("Scholarship Category: Not Eligible")

if scholarship > 0:
    print("Scholarship Amount: Rs.", scholarship)
    print("Status: Scholarship Allocated")
else:
    print("Status: Scholarship Not Allocated")


