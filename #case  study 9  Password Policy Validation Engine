
# Password Policy Validation Engine

passwords = [
    "abc",
    "Password123!",
    "Abc111!xyz",
    "Strong@42",
    "Admin@1234"
]

forbidden = ["password", "admin", "1234"]

for password in passwords:
    errors = []

    # Rule 1: Minimum length
    if len(password) < 8:
        errors.append("Password must contain at least 8 characters")

    # Rule 2: Character categories
    if not any(c.isupper() for c in password):
        errors.append("Missing uppercase letter")

    if not any(c.islower() for c in password):
        errors.append("Missing lowercase letter")

    if not any(c.isdigit() for c in password):
        errors.append("Missing digit")

    if not any(not c.isalnum() for c in password):
        errors.append("Missing special character")

    # Rule 3: Repeated characters
    for i in range(len(password) - 2):
        if password[i] == password[i + 1] == password[i + 2]:
            errors.append("Same character repeated 3 times consecutively")
            break

    # Rule 4: Forbidden substrings
    found = []

    for word in forbidden:
        if word in password.lower():
            found.append(word)

    if found:
        errors.append("Contains forbidden text: " + ", ".join(found))

    # Display results
    print("Password:", password)

    if len(errors) == 0:
        print("Result: Valid Password")
    else:
        print("Result: Invalid Password")
        for error in errors:
            print("-", error)

