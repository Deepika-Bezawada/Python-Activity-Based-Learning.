
# Warehouse Inventory Reconciliation

n = int(input("Enter number of products: "))

for i in range(n):
    print("Enter details for Product", i + 1)

    name = input("Product name: ")
    opening = int(input("Opening stock: "))
    incoming = int(input("Incoming quantity: "))
    dispatched = int(input("Dispatched quantity: "))
    closing = int(input("Actual closing stock: "))
    minimum = int(input("Minimum required stock: "))

    # Calculate expected closing stock
    expected = opening + incoming - dispatched

    print(" Inventory Report ")
    print("Product:", name)
    print("Opening Stock:", opening)
    print("Incoming Stock:", incoming)
    print("Dispatched Stock:", dispatched)
    print("Expected Closing Stock:", expected)
    print("Actual Closing Stock:", closing)

    # Detect discrepancy
    difference = closing - expected

    if difference == 0:
        print("Status: Stock matches")
    elif difference > 0:
        print("Status: Extra stock found")
        print("Discrepancy:", difference)
    else:
        print("Status: Stock shortage")
        print("Discrepancy:", abs(difference))

    # Calculate replenishment requirement
    required = minimum - closing

    if required > 0:
        print("Replenishment Required:", required, "units")
    else:
        print("Replenishment Required: 0 units")

print("\nInventory reconciliation completed.")

